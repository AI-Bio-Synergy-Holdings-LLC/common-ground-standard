{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AI-Bio-Synergy-Holdings-LLC/common-ground-standard/main/evidence-validator/schema/common-ground-public-evidence.v0.1.schema.json",
  "title": "Common Ground public evidence manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "assetRegistryId",
    "title",
    "claim",
    "reviewScope",
    "affectedPartyGovernance",
    "limitations",
    "sources",
    "files",
    "validatorEffect",
    "claimBoundary"
  ],
  "properties": {
    "schemaVersion": { "const": "common-ground-public-evidence/v0.1" },
    "recordId": { "type": "string", "pattern": "^CGR-[A-Z0-9][A-Z0-9._-]{2,63}$" },
    "assetRegistryId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^IP-[0-9]{3,}$" }
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 300 },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primaryStatus", "assertedBy", "authority", "grantsStatus"],
      "properties": {
        "primaryStatus": {
          "enum": [
            "DRAFT_ASSERTION",
            "REVIEW_RECORD",
            "ALIGNMENT_RECORD",
            "ENDORSEMENT_RECORD",
            "CERTIFICATION_RECORD"
          ]
        },
        "assertedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reference"],
          "properties": {
            "kind": {
              "enum": [
                "SELF_DECLARATION",
                "REVIEW_AUTHORITY",
                "ALIGNMENT_AUTHORITY",
                "ENDORSEMENT_AUTHORITY",
                "CERTIFICATION_AUTHORITY"
              ]
            },
            "reference": {
              "oneOf": [
                { "type": "null" },
                { "type": "string", "format": "uri", "pattern": "^https://" }
              ]
            }
          }
        },
        "grantsStatus": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "primaryStatus": { "const": "DRAFT_ASSERTION" } } },
          "then": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "SELF_DECLARATION" },
                  "reference": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "primaryStatus": { "const": "REVIEW_RECORD" } } },
          "then": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "REVIEW_AUTHORITY" },
                  "reference": { "type": "string", "pattern": "^https://" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "primaryStatus": { "const": "ALIGNMENT_RECORD" } } },
          "then": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "ALIGNMENT_AUTHORITY" },
                  "reference": { "type": "string", "pattern": "^https://" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "primaryStatus": { "const": "ENDORSEMENT_RECORD" } } },
          "then": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "ENDORSEMENT_AUTHORITY" },
                  "reference": { "type": "string", "pattern": "^https://" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "primaryStatus": { "const": "CERTIFICATION_RECORD" } } },
          "then": {
            "properties": {
              "authority": {
                "properties": {
                  "kind": { "const": "CERTIFICATION_AUTHORITY" },
                  "reference": { "type": "string", "pattern": "^https://" }
                }
              }
            }
          }
        }
      ]
    },
    "reviewScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "included", "excluded"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "included": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "affectedPartyGovernance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description", "sourceIds"],
      "properties": {
        "status": { "enum": ["NOT_ESTABLISHED", "DECLARED", "DOCUMENTED"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "sourceIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourceId" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "NOT_ESTABLISHED" } } },
          "then": { "properties": { "sourceIds": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "DOCUMENTED" } } },
          "then": { "properties": { "sourceIds": { "minItems": 1 } } }
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "uri", "retrievedOn"],
        "properties": {
          "id": { "$ref": "#/$defs/sourceId" },
          "title": { "type": "string", "minLength": 1, "maxLength": 300 },
          "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
          "retrievedOn": { "type": "string", "format": "date" }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "bytes", "sha256", "sourceIds"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "mediaType": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/sourceId" }
          }
        }
      }
    },
    "validatorEffect": { "const": "STRUCTURAL_VALIDITY_ONLY" },
    "claimBoundary": {
      "const": "Structural validity and byte-level integrity do not establish truth, evidence sufficiency, independence, review, alignment, endorsement, certification, compliance, partnership, pilot status, public benefit, or authority."
    }
  },
  "$defs": {
    "sourceId": { "type": "string", "pattern": "^SRC-[A-Z0-9][A-Z0-9._-]{1,31}$" }
  }
}
